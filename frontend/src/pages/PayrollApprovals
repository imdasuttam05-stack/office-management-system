import React,{useEffect,useMemo,useState} from "react";
import {hrApi} from "../lib/hrApi.js";

const money=n=>`₹${Number(n||0).toLocaleString("en-IN",{maximumFractionDigits:2})}`;
export default function PayrollApprovals(){
 const now=new Date(),[month,setMonth]=useState(now.getMonth()+1),[year,setYear]=useState(now.getFullYear()),[rows,setRows]=useState([]),[selected,setSelected]=useState([]),[error,setError]=useState(""),[message,setMessage]=useState(""),[loading,setLoading]=useState(false);
 async function load(){try{setError("");const r=await hrApi.payrollApprovals(`?month=${month}&year=${year}`);setRows(r.approvals||[]);setSelected([]);}catch(e){setError(e.message)}}
 useEffect(()=>{load()},[month,year]);
 const pending=useMemo(()=>rows.filter(r=>!r.overtimeApproved||!r.cuttingApproved),[rows]);
 function toggle(id){setSelected(s=>s.includes(id)?s.filter(x=>x!==id):[...s,id])}
 async function approve(type,value){if(!selected.length)return setError("Select at least one record.");try{setLoading(true);setError("");await hrApi.approvePayrollAdjustments({ids:selected,overtimeApproved:type==="ot"?value:undefined,cuttingApproved:type==="cut"?value:undefined});setMessage("Approval updated successfully.");await load();}catch(e){setError(e.message)}finally{setLoading(false)}}
 async function approveBoth(){if(!selected.length)return setError("Select at least one record.");try{setLoading(true);await hrApi.approvePayrollAdjustments({ids:selected,overtimeApproved:true,cuttingApproved:true});setMessage("Selected OT and cutting approved.");await load();}catch(e){setError(e.message)}finally{setLoading(false)}}
 return <main style={S.page}><div style={S.wrap}><header style={S.head}><div><h1>Payroll Approvals</h1><p>Approve overtime and cutting before salary is processed.</p></div><div><select style={S.input} value={month} onChange={e=>setMonth(e.target.value)}>{Array.from({length:12},(_,i)=><option key={i+1} value={i+1}>{new Date(2000,i,1).toLocaleString("en-IN",{month:"long"})}</option>)}</select><input style={S.input} type="number" value={year} onChange={e=>setYear(e.target.value)}/></div></header>
 {error&&<div style={S.err}>{error}</div>}{message&&<div style={S.ok}>{message}</div>}
 <div style={S.cards}><div><b>{rows.length}</b><span>Total Adjustments</span></div><div><b>{pending.length}</b><span>Pending Review</span></div><div><b>{rows.filter(x=>x.overtimeApproved).length}</b><span>OT Approved</span></div><div><b>{rows.filter(x=>x.cuttingApproved).length}</b><span>Cutting Approved</span></div></div>
 <div style={S.toolbar}><label><input type="checkbox" checked={rows.length>0&&selected.length===rows.length} onChange={e=>setSelected(e.target.checked?rows.map(x=>x._id):[])}/> Select All</label><button style={S.btn} disabled={!selected.length||loading} onClick={approveBoth}>Approve Selected OT + Cutting</button><button style={S.btn2} disabled={!selected.length||loading} onClick={()=>approve("ot",true)}>Approve OT</button><button style={S.btn3} disabled={!selected.length||loading} onClick={()=>approve("cut",true)}>Approve Cutting</button></div>
 <section style={S.table}><div style={S.thead}><span></span><span>Date</span><span>Employee</span><span>Shift</span><span>OT</span><span>Cutting</span><span>Approval</span></div>{rows.map(r=>{const ot=Number(r.overtimeHours||0),cut=Number(r.cuttingMinutes||0);return <div style={S.tr} key={r._id}><input type="checkbox" checked={selected.includes(r._id)} onChange={()=>toggle(r._id)}/><span>{new Date(r.date).toLocaleDateString("en-IN")}</span><span><b>{r.employeeId?.name||"-"}</b><small>{r.employeeId?.employeeCode||""}</small></span><span>{r.shiftId?.name||r.shiftName||"-"}</span><span><b>{ot.toFixed(2)} h</b><small>{r.overtimeApproved?"Approved":"Pending"}</small></span><span><b>{Math.floor(cut/60)}h {cut%60}m</b><small>{r.cuttingApproved?"Approved":"Pending"}</small></span><span>{r.overtimeApproved&&r.cuttingApproved?<em style={S.approved}>Approved</em>:<em style={S.pending}>Pending</em>}</span></div>})}</section>
 </div></main>
}
const S={page:{minHeight:"100vh",background:"#f5f7fb",padding:24,fontFamily:"Arial"},wrap:{maxWidth:1300,margin:"0 auto"},head:{display:"flex",justifyContent:"space-between",alignItems:"center",gap:20},input:{padding:11,border:"1px solid #d0d5dd",borderRadius:9,marginLeft:7},err:{background:"#fee4e2",color:"#b42318",padding:12,borderRadius:10,margin:"15px 0"},ok:{background:"#dcfae6",color:"#067647",padding:12,borderRadius:10,margin:"15px 0"},cards:{display:"grid",gridTemplateColumns:"repeat(4,1fr)",gap:12,margin:"20px 0"},toolbar:{display:"flex",alignItems:"center",gap:10,background:"#fff",padding:15,borderRadius:12,marginBottom:14},btn:{background:"#1d4f91",color:"#fff",border:0,padding:"10px 14px",borderRadius:8,fontWeight:700},btn2:{background:"#e8f1ff",color:"#174ea6",border:0,padding:"10px 14px",borderRadius:8,fontWeight:700},btn3:{background:"#fff0f0",color:"#b42318",border:0,padding:"10px 14px",borderRadius:8,fontWeight:700},table:{background:"#fff",borderRadius:14,overflow:"hidden"},thead:{display:"grid",gridTemplateColumns:"30px 110px 1.5fr 1fr .8fr .8fr 100px",gap:10,padding:14,background:"#eef2f7",fontWeight:700},tr:{display:"grid",gridTemplateColumns:"30px 110px 1.5fr 1fr .8fr .8fr 100px",gap:10,padding:14,borderTop:"1px solid #eef2f7",alignItems:"center"},cardsItem:{},approved:{background:"#dcfae6",color:"#067647",padding:"5px 8px",borderRadius:20,fontStyle:"normal"},pending:{background:"#fff4e5",color:"#b54708",padding:"5px 8px",borderRadius:20,fontStyle:"normal"}};
